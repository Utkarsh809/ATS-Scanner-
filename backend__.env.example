# ---------- Server ----------
PORT=5000
NODE_ENV=development
# The URL of the frontend (used for CORS). In production, your Vercel URL.
FRONTEND_URL=http://localhost:3000

# ---------- Database (Neon / Supabase) ----------
# Paste the connection string from your Neon or Supabase dashboard.
# Neon example:     postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Supabase example: postgresql://postgres.xxxx:password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_URL=
# Set to "true" only if your provider gives you a CA you have installed. Most student setups leave this false.
DB_SSL_STRICT=false

# ---------- Security ----------
# Long random string used to sign login tokens. Generate one with: npm run gen:key
JWT_SECRET=
# 64 hex characters (32 bytes) used to encrypt uploaded resume files. Generate with: npm run gen:key
# IMPORTANT: if you change this later, old uploaded files can no longer be decrypted.
ENCRYPTION_KEY=

# ---------- AI services (optional) ----------
# Leave empty to use the built-in local fallbacks. Add keys later to switch to the real APIs.
# Free Hugging Face token: https://huggingface.co/settings/tokens  (type: "Read")
HF_API_TOKEN=
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Free Gemini key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---------- Scoring weights (Appendix C, TBD #1) ----------
# Must add up to 1.0. They are normalised automatically if they don't.
WEIGHT_KEYWORD=0.5
WEIGHT_SEMANTIC=0.3
WEIGHT_COMPLETENESS=0.2
